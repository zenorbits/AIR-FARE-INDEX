# Copy to .env and point at your running backend (see Backend/README.md —
# `python -m uvicorn api.main:app --reload` binds :8000 by default).
VITE_API_BASE_URL=http://localhost:8000

# Must match the backend's own API_KEY (Backend/.env). Local development
# only — never put a production key in a Vite env var, since it ships in
# the browser bundle. See the warning in src/api/client.js.
VITE_API_KEY=
