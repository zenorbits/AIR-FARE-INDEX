DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/flight_scraper
API_KEY=your_api_key_here

# Optional: comma-separated extra origins allowed to call this API (e.g. your
# deployed frontend's URL). localhost:3000/5173 are always allowed for dev.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: enables POST /assistant/ask (RAG-backed explanations). Get a free
# key at https://aistudio.google.com/apikey -- the endpoint 503s without it.
# GEMINI_API_KEY=your_gemini_api_key_here
